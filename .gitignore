# Local Python environments and caches
.venv/
.venv-*/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.env
.env.*
!.env.example
.idea/
.vscode/

# Rebuilt distribution; retain the original input archive used by the packager
/*.zip
!/oled-ag-sparkle-skill.zip
/oled-ag-sparkle/outputs/
/tmp/
# Derived floating height arrays can be regenerated from the deterministic generator.
/oled-ag-sparkle/assets/oled-1mm-etched-ag/height_um.npy
/oled-ag-sparkle/assets/oled-1mm-etched-ag-pitch0p5/height_um.npy

