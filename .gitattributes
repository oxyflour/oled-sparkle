* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.log text eol=lf
*.txt text eol=lf
*.ps1 text eol=crlf
*.png binary
*.npy binary
*.zip binary
# Standalone reports contain embedded images and raw arrays; avoid huge text diffs.
test-results/**/report.html binary
# Frozen comparison manifests hash JSON bytes; preserve their captured line endings.
test-results/oled-layout-comparison/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
test-results/oled-camera-comparison/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
